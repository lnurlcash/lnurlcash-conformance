{
  "name": "lnurlcash-conformance",
  "version": "0.8.0",
  "description": "Language-neutral conformance vectors, an adversarial mock mint, and a grader for LNURLcash (LUD-25) implementations",
  "author": "TheCryptoDonkey",
  "license": "MIT",
  "publishConfig": {
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheCryptoDonkey/lnurlcash-conformance.git"
  },
  "homepage": "https://github.com/TheCryptoDonkey/lnurlcash-conformance#readme",
  "bugs": {
    "url": "https://github.com/TheCryptoDonkey/lnurlcash-conformance/issues"
  },
  "type": "module",
  "keywords": [
    "lnurl",
    "lnurlcash",
    "lud-25",
    "lightning",
    "conformance",
    "test-vectors"
  ],
  "files": [
    "vectors",
    "mock-mint",
    "runner",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "exports": {
    ".": {
      "types": "./runner/index.d.ts",
      "default": "./runner/index.mjs"
    },
    "./vectors/*": "./vectors/*",
    "./mock-mint": {
      "types": "./mock-mint/index.d.ts",
      "default": "./mock-mint/index.mjs"
    }
  },
  "bin": {
    "lnurlcash-conform": "./runner/cli.mjs",
    "lnurlcash-mock-mint": "./mock-mint/index.mjs"
  },
  "scripts": {
    "generate": "node tools/generate.mjs",
    "test": "node tools/selfcheck.mjs",
    "mint": "node mock-mint/index.mjs",
    "check": "npm run generate && git diff --exit-code vectors/ && npm test && node tools/selfgrade.mjs",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@scure/base": "^1.2.4"
  },
  "devDependencies": {
    "@scure/bip39": "^2.3.0"
  }
}
